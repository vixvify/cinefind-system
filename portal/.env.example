# Copy to .env.local. Next.js reads these only on the server.
# Use either a TMDB API Read Access Token (recommended) or a v3 API key.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional: absolute path, or relative to the portal working directory.
# Default: ../ai/data/raw/tmdb_5000_movies.csv
# MOVIE_DATASET_PATH=../ai/data/raw/tmdb_5000_movies.csv
